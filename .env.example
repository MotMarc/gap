# Placeholder-only Sprint 14 configuration.
APP_ENV=demonstration
APP_VERSION=0.15.0
PERSISTENCE_MODE=database
DATABASE_URL=sqlite:///runtime/gap.db
RUNTIME_DIRECTORY=runtime
KEY_DIRECTORY=implementation/keys
BACKUP_DIRECTORY=runtime/backups
LOG_LEVEL=INFO
ADMIN_API_ENABLED=false
ADMIN_API_TOKEN_HASH=<sha256-hex-digest>
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
MAX_REQUEST_SIZE=2097152
STARTUP_STRICT_MODE=true
HEALTH_DETAILS_ENABLED=false
